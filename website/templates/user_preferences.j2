{% extends 'base.j2' %}
{% block title %}Mes préférences{% endblock %}

{% block head %}
{{ super() }}
{% for url in asset_css('assets/js/markdown-editor.js') %}
<link rel="stylesheet" href="{{ url }}">
{% endfor %}
{% endblock %}

{% block content %}
<h1 class="text-center font-black text-2xl my-4">
  <i class="ph ph-sliders-horizontal" aria-hidden="true"></i> Mes préférences
</h1>

<p class="text-center text-sm text-base-content/70 max-w-2xl mx-auto mb-4">
  Ces valeurs pré-remplissent le formulaire de création d'une nouvelle annonce. Elles n'ont aucun effet
  sur les annonces existantes, y compris lorsque vous en éditez ou clonez une. Laissez un champ vide pour
  ne définir aucune préférence.
</p>

{% set lbl = "text-sm font-semibold text-base-content/70 mb-0.5 block" %}

<form method="post" action="{{ url_for('profile.update_preferences') }}" class="max-w-3xl mx-auto space-y-4">
  <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">

  <div class="card bg-base-100 shadow-md">
    <div class="card-body p-4 space-y-3">

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="flex flex-col gap-1">
          <label for="pref_type" class="{{ lbl }}">Type de session</label>
          <select id="pref_type" name="type" class="select select-bordered w-full">
            <option value="">(Aucune préférence)</option>
            <option value="oneshot" {% if game_defaults.type=="oneshot" %}selected{% endif %}>One Shot</option>
            <option value="campaign" {% if game_defaults.type=="campaign" %}selected{% endif %}>Campagne</option>
          </select>
        </div>

        <div class="flex flex-col gap-1">
          <label for="pref_system" class="{{ lbl }}">Système</label>
          <select id="pref_system" name="system" class="select select-bordered w-full">
            <option value="">(Aucune préférence)</option>
            {% for s in systems %}
            <option value="{{ s.id }}" {% if game_defaults.system==s.id %}selected{% endif %}>{{ s.name }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="flex flex-col gap-1">
          <label for="pref_vtt" class="{{ lbl }}">VTT</label>
          <select id="pref_vtt" name="vtt" class="select select-bordered w-full">
            <option value="">(Aucune préférence)</option>
            {% for v in vtts %}
            <option value="{{ v.id }}" {% if game_defaults.vtt==v.id %}selected{% endif %}>{{ v.name }}</option>
            {% endfor %}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="flex flex-col gap-1">
          <label for="pref_session_length" class="{{ lbl }}">Durée par session (h)</label>
          <input type="number" id="pref_session_length" name="session_length" step="0.5" min="0.5" max="24"
            class="input input-bordered w-full" value="{{ game_defaults.session_length or '' }}">
        </div>

        <div class="flex flex-col gap-1">
          <label for="pref_party_size" class="{{ lbl }}">Nombre de joueur·euses</label>
          <input type="number" id="pref_party_size" name="party_size" step="1" min="1" max="99"
            class="input input-bordered w-full" value="{{ game_defaults.party_size or '' }}">
        </div>

        <label class="flex items-center gap-2 cursor-pointer select-none self-end pb-2">
          <input type="checkbox" name="party_selection" class="toggle toggle-primary toggle-sm" {% if
            game_defaults.party_selection %}checked{% endif %}>
          <span class="text-sm text-base-content/70">Sur sélection</span>
        </label>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="flex flex-col gap-1">
          <label for="pref_xp" class="{{ lbl }}">Expérience</label>
          <select id="pref_xp" name="xp" class="select select-bordered w-full">
            <option value="">(Aucune préférence)</option>
            <option value="all" {% if game_defaults.xp=="all" %}selected{% endif %}>Débutants bienvenus</option>
            <option value="beginners" {% if game_defaults.xp=="beginners" %}selected{% endif %}>Réservé aux débutants
            </option>
            <option value="seasoned" {% if game_defaults.xp=="seasoned" %}selected{% endif %}>Interdit aux débutants
            </option>
          </select>
        </div>

        <div class="flex flex-col gap-1">
          <label for="pref_characters" class="{{ lbl }}">Personnages</label>
          <select id="pref_characters" name="characters" class="select select-bordered w-full">
            <option value="">(Aucune préférence)</option>
            <option value="with_gm" {% if game_defaults.characters=="with_gm" %}selected{% endif %}>Avec le·a MJ
            </option>
            <option value="self" {% if game_defaults.characters=="self" %}selected{% endif %}>Seul·e</option>
            <option value="pregen" {% if game_defaults.characters=="pregen" %}selected{% endif %}>Prétirés</option>
            <option value="choice" {% if game_defaults.characters=="choice" %}selected{% endif %}>Au choix</option>
          </select>
        </div>
      </div>

      <fieldset>
        <legend class="{{ lbl }}">Ambiance</legend>
        <div class="flex flex-wrap gap-4">
          {% for key, icon, label in [
          ('chill', 'ph-couch', 'Décontractée'),
          ('serious', 'ph-book-open-text', 'Sérieuse'),
          ('comic', 'ph-mask-happy', 'Comique'),
          ('epic', 'ph-sword', 'Épique'),
          ] %}
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input type="checkbox" class="toggle toggle-primary toggle-sm" name="{{ key }}" {% if key in
              (game_defaults.ambience or []) %}checked{% endif %}>
            <span class="text-sm flex items-center gap-1.5">
              <i class="ph {{ icon }}" aria-hidden="true"></i> {{ label }}
            </span>
          </label>
          {% endfor %}
        </div>
      </fieldset>

    </div>
  </div>

  <div class="card bg-base-100 shadow-md">
    <div class="card-body p-4 space-y-3">

      <div class="flex flex-col gap-1">
        <label for="pref_description" class="{{ lbl }}">Canevas de description</label>
        <textarea id="pref_description" name="description" class="textarea textarea-bordered w-full"
          data-markdown-editor data-min-height="150px" rows="4"
          placeholder="Ex. : un plan type avec les sections que vous détaillez habituellement (Pitch, Ambiance, Ce qu'il faut savoir...). Pas une description toute faite : juste de quoi partir plus vite.">{{ game_defaults.description or '' }}</textarea>
      </div>

      <div class="flex flex-col gap-1">
        <label for="pref_complement" class="{{ lbl }}">Canevas d'informations complémentaires</label>
        <textarea id="pref_complement" name="complement" class="textarea textarea-bordered w-full" data-markdown-editor
          data-min-height="100px" rows="2"
          placeholder="Ex. : des rappels que vous ajoutez systématiquement (Niveau des personnages, utilisation d'IA ou non, partie ou support en anglais…...).">{{ game_defaults.complement or '' }}</textarea>
      </div>

    </div>
  </div>

  <button type="submit" class="btn btn-primary btn-block gap-2">
    <i class="ph ph-floppy-disk" aria-hidden="true"></i> Enregistrer mes préférences
  </button>
</form>
{% endblock %}

{% block scripts %}{{ super() }}
<script type="module" src="{{ asset('assets/js/markdown-editor.js') }}"></script>
{% endblock %}